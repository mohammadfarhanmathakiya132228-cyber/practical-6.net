@model ProductCatalog.Models.Product

<h1>Create Product</h1>

<hr />

<form asp-action="Create" method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <p>
        <label asp-for="Name">Product Name</label><br />
        <input asp-for="Name" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </p>

    <p>
        <label asp-for="Price">Price</label><br />
        <input asp-for="Price" type="number" step="0.01" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </p>

    <p>
        <label asp-for="Category">Category</label><br />
        <input asp-for="Category" />
        <span asp-validation-for="Category" class="text-danger"></span>
    </p>

    <p>
        <label asp-for="ImageUrl">Image URL</label><br />
        <input asp-for="ImageUrl" />
        <span asp-validation-for="ImageUrl" class="text-danger"></span>
    </p>

    <button type="submit">Create Product</button>

</form>

<br />

<a asp-action="Index">View Products</a>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
